[Unit]
Description=VhostFactory - Automatic Nginx + SSL Setup Daemon
After=network.target nginx.service
Wants=vhostfactory-renewal.timer

[Service]
Type=simple
User=root
Environment=PYTHONPATH=/opt/vhostfactory
ExecStart=/opt/vhostfactory/venv/bin/python -m vhostfactory.main
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vhostfactory

[Install]
WantedBy=multi-user.target
